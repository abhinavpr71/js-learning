let nums = [3,1,2,10,1]

function runningSum(nums){
  let newNums = []
  let runningTotal = nums[0]
  newNums.push(runningTotal)
  for (let i = 1 ; i < nums.length; ++i){
    runningTotal = runningTotal + nums[i]
    newNums.push(runningTotal)
  }
 
  return newNums
}

console.log(runningSum(nums))
